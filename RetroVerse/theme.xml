<theme defaultView="Boxes+Info" defaultTransition="fade & slide">


	<formatVersion>7</formatVersion>

	<!-- Include Configuration Files -->
	<include subset="music" name="Mute" displayName="${silence}">./nosounds.xml</include>
	<include subset="music" name="On" displayName="${sysmusic}">./sounds.xml</include>
	<include subset="music" name="Off" displayName="${nomusic}"/>

	<!-- Musikdateien im eigenen Ordner definieren -->
	<audio name="background_music">
		<path>../../music</path>		<!-- Benutzerdefinierte Musik (OGG-Format) -->
	</audio>

	<variables>
	</variables>

	<!-- Screen view properties Akku, Uhrzeit, Controller Activity -->
	<view name="screen">

		<!-- Controller Activity - ganz links -->
		<controllerActivity name="controllerActivity">
			<pos>0.02 0.019</pos>			<!-- Leicht nach rechts verschoben vom Rand -->
			<size>0.072395833333333 0.017592592592593</size>
			<imagePath>./_inc/gamepad.svg</imagePath>
			<gunPath>./_inc/gun.svg</gunPath>
			<itemSpacing>0.003</itemSpacing>
			<color>FFFFFF90</color>
			<activityColor>FFFFFF</activityColor>
			<hotkeyColor>DEEC00</hotkeyColor>
			<origin>0 0</origin>
		</controllerActivity>

		<!-- Clock/Music Display - mittig links positioniert -->
		<text name="clock">
			<color>FFFFFF99</color>
			<fontSize>0.018</fontSize>
			<fontPath>./_inc/fonts/RedHatDisplay-Regular.ttf</fontPath>
			<pos>0.12 0.019</pos>			<!-- Links vom Battery Icon -->
			<origin>0 0</origin>
			<size>0.30 0.04</size>
			<alignment>left</alignment>
		</text>

		<!-- Battery and Wifi icons - bleiben rechts -->
