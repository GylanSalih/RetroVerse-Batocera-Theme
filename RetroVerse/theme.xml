			<margin>-0.50 -0.02</margin>		<!-- Guter Abstand -->
			<scrollSound>./_inc/sound/scroll01.wav</scrollSound>
			<autoLayoutSelectedZoom>1.2</autoLayoutSelectedZoom>
		</imagegrid>

		<!-- Gridtile Styles - 30% größere Bilder -->
		<gridtile name="default">
			<size>0.325 0.39</size>			<!-- 30% größer (0.25*1.3=0.325, 0.30*1.3=0.39) -->
			<padding>0 0</padding>			<!-- Kein Padding - Bilder nutzen vollen Platz -->
			<imageSizeMode>maxSize</imageSizeMode>	<!-- Bilder nutzen maximale Größe -->
			<backgroundColor>42424200</backgroundColor>
			<imageColor>ffffff</imageColor>
		</gridtile>

		<gridtile name="selected">
			<size>0.325 0.39</size>			<!-- 30% größer (0.25*1.3=0.325, 0.30*1.3=0.39) -->
			<padding>0 0</padding>			<!-- Kein Padding - Bilder nutzen vollen Platz -->
			<imageSizeMode>maxSize</imageSizeMode>	<!-- Bilder nutzen maximale Größe -->
			<imageColor>ffffff</imageColor>
		</gridtile>

		<!-- Spieltitel unter Cover ausblenden -->
		<text name="gridtile">
			<visible>false</visible>
		</text>

		<!-- Alle Meta-Informationen ausblenden -->
		<text name="md_name">
			<pos>-2 -2</pos>
			<visible>false</visible>
		</text>
		<text name="md_publisher">
			<pos>-2 -2</pos>
			<visible>false</visible>
		</text>
		<text name="md_genre">
			<pos>-2 -2</pos>
			<visible>false</visible>
		</text>
		<text name="md_players">
			<pos>-2 -2</pos>
			<visible>false</visible>
		</text>
		<text name="md_description">
			<pos>-2 -2</pos>
			<visible>false</visible>
		</text>
		<image name="md_marquee">
			<pos>-2 -2</pos>
			<visible>false</visible>
		</image>
		<video name="md_video">
			<pos>-2 -2</pos>
			<visible>false</visible>
