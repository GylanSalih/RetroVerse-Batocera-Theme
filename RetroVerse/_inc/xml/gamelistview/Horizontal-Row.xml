<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>

	<!-- ===================================================== -->
	<!-- Horizontal-Row layout -->
	<!-- ===================================================== -->

	<customView name="Horizontal-Row" inherits="grid">

		<!-- Position of the boxes carousel -->

		<imagegrid name="gamegrid">
			<centerSelection>true</centerSelection>
			<scrollLoop>false</scrollLoop>
			<pos>0 0.14</pos>

			<!--<pos if="{system.theme} == 'gb' || {system.theme} == 'gb2players' ">0 0.07</pos>-->

			<size>1 0.55</size>
			<!--<size if="{system.theme} == 'gb' || {system.theme} == 'gb2players'  || {system.theme} == 'fds' || {system.theme} == 'gbc' || {system.theme} == 'gbc2players'">1 0.65</size>-->

			<margin>0 0</margin>
			<autoLayout>5 1</autoLayout>
			<autoLayoutSelectedZoom>1.2</autoLayoutSelectedZoom>

			<autoLayout if="{system.theme} == 'psp' || {system.theme} == 'saturn' || {system.theme} == 'c64'  || {system.theme} == 'c20' || {system.theme} == 'zxspectrum'">7 1</autoLayout>

			<autoLayoutSelectedZoom if="{system.theme} == 'atarilynx'">1.3</autoLayoutSelectedZoom>

			<autoLayoutSelectedZoom if="{system.theme} == 'ps3' || {system.theme} == 'psp' || {system.theme} == 'saturn' || {system.theme} == 'ngp' || {system.theme} == 'ngpc'">1.4</autoLayoutSelectedZoom>

			<autoLayoutSelectedZoom if="{system.theme} == 'n64' || {system.theme} == 'c64' || {system.theme} == 'c20' || {system.theme} == 'zxspectrum'">1.5</autoLayoutSelectedZoom>

			<autoLayoutSelectedZoom if="{system.theme} == 'neogeocd'
			|| {system.theme} == 'psx'  
			|| {system.theme} == 'dreamcast' 
			|| {system.theme} == 'cdi' 
			|| {system.theme} == '3do'
			|| {system.theme} == '3ds'
			|| {system.theme} == 'nds'
			|| {system.theme} == 'gba'
			|| {system.theme} == 'n64dd'
			|| {system.theme} == 'virtualboy'
			|| {system.theme} == 'supergrafx'
			|| {system.theme} == 'pce-cd'
			|| {system.theme} == 'pcengine'	
			|| {system.theme} == 'amigacdtv'
			|| {system.theme} == 'segacd'
			|| {system.theme} == 'gb'
			|| {system.theme} == 'gb2players'
			|| {system.theme} == 'gbc'
			|| {system.theme} == 'gbc2players'
			|| {system.theme} == 'fds'">1.60</autoLayoutSelectedZoom>

			<autoLayoutSelectedZoom if="{system.theme} == 'snes' || {system.theme} == 'n64'|| {system.theme} == 'gameandwatch'|| {system.theme} == 'scv'">1.90</autoLayoutSelectedZoom>


			<scrollDirection>horizontal</scrollDirection>
			<scrollSound>./_inc/sound/cursor.wav</scrollSound>

		</imagegrid>


		<gridtile name="default">
			<size>0.177083333333333 1</size>
			<backgroundCornerSize>0 0</backgroundCornerSize>
			<padding>20 50</padding>
			<imageColor>4e4e4eff</imageColor>
		</gridtile>

		<gridtile name="selected">
			<size>0.177083333333333 1</size>
			<backgroundCornerSize>0 0</backgroundCornerSize>
			<imageColor>ffffffff</imageColor>
		</gridtile>

		<!-- this is a background tint replacement for the one set by the grid view so abgedunkelte art ganzer bildschirm-->

		<image name="gridOverlay" extra="true">
			<path>./_inc/assets/tilesoverlay.png</path>
			<color>000000FF</color>			<!-- Schwarz mit voller Deckkraft -->
			<size>1 1</size>
			<pos>1 1</pos>
			<origin>1 1</origin>
			<zIndex>8</zIndex>
		</image>



		<!-- Game meta assets -->

		<image name="meta-genre" extra="true">
			<origin>0.5 0</origin>
			<pos>0.34296875 0.8018518518518519</pos>
			<size>0.0625 0.0740740740740741</size>
			<path>./_inc/icons/Metadata-Icons/meta-genre.svg</path>
			<path>./${system.theme}/_inc/icons/Metadata-Icons/meta-genre.svg</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>99</zIndex>
		</image>

		<text name="md_genre">
			<origin>0.5 0</origin>
			<pos>0.34296875 0.8611111111111111</pos>
			<size>0.0625 0.034259259259259</size>
			<alignment>center</alignment>
			<color>ffffff</color>
			<fontSize>0.014814814814815</fontSize>
			<fontPath>./_inc/fonts/RedHatDisplay-Medium.ttf</fontPath>
		</text>


		<image name="meta-players" extra="true">
			<origin>0.5 0</origin>
			<pos>0.44765625 0.8018518518518519</pos>
			<size>0.0625 0.0740740740740741</size>
			<path>./_inc/icons/Metadata-Icons/meta-players.svg</path>
			<path>./${system.theme}/_inc/icons/Metadata-Icons/meta-players.svg</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>99</zIndex>
		</image>


		<text name="md_players">
			<origin>0.5 0</origin>
			<pos>0.44765625 0.8611111111111111</pos>
			<size>0.0625 0.034259259259259</size>
			<alignment>center</alignment>
			<color>ffffff</color>
			<fontSize>0.014814814814815</fontSize>
			<fontPath>./_inc/fonts/RedHatDisplay-Medium.ttf</fontPath>
		</text>


		<image name="meta-publisher" extra="true">
			<origin>0.5 0</origin>
			<pos>0.55234375 0.8018518518518519</pos>
			<size>0.0625 0.0740740740740741</size>
			<path>./_inc/icons/Metadata-Icons/meta-publisher.svg</path>
			<path>./${system.theme}/_inc/icons/Metadata-Icons/meta-publisher.svg</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>99</zIndex>
		</image>


		<text name="md_publisher">
			<origin>0.5 0</origin>
			<pos>0.55234375 0.8611111111111111</pos>
			<size>0.0625 0.034259259259259</size>
			<color>ffffff</color>
			<fontSize>0.014814814814815</fontSize>
			<fontPath>./_inc/fonts/RedHatDisplay-Medium.ttf</fontPath>
			<alignment>center</alignment>
		</text>


		<image name="meta-date" extra="true">
			<origin>0.5 0</origin>
			<pos>0.65703125 0.8018518518518519</pos>
			<size>0.0625 0.0740740740740741</size>
			<path>./_inc/icons/Metadata-Icons/meta-date.svg</path>
			<path>./${system.theme}/_inc/icons/Metadata-Icons/meta-date.svg</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>99</zIndex>
		</image>


		<datetime name="md_releasedate">
			<origin>0.5 0</origin>
			<pos>0.65703125 0.8611111111111111</pos>
			<size>0.0625 0.034259259259259</size>
			<color>ffffff</color>
			<fontSize>0.014814814814815</fontSize>
			<fontPath>./_inc/fonts/RedHatDisplay-Medium.ttf</fontPath>
			<format>%Y</format>
			<alignment>center</alignment>
		</datetime>


		<!-- beschreibung text (maximal 3 Zeilen) -->
		<text name="md_description">
			<origin>0.5 0</origin>
			<pos>0.5 0.9</pos>
			<size>0.4 0.048</size>
			<alignment>center</alignment>
			<color>ffffff</color>
			<fontPath>./_inc/fonts/RedHatDisplay-Regular.ttf</fontPath>
			<fontSize>0.016</fontSize>
			<lineSpacing>1.0</lineSpacing>
		</text>


		<image name="dividers" extra="true">
			<origin>0.5 0</origin>
			<pos>0.5 0.8018518518518519</pos>
			<size>0.2098958333333333 0.0462962962962963</size>
			<path>./_inc/assets/dividers.svg</path>
			<zIndex>99</zIndex>
			<linearSmooth>true</linearSmooth>
		</image>


		<text name="md_name">
			<pos>0.5 0.75</pos>
			<size>0.99 0.055555555555556</size>
			<origin>0.5 0.5</origin>
			<alignment>center</alignment>
			<fontPath>./_inc/fonts/RedHatDisplay-Regular.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<color>ffffffff</color>
			<zIndex>100</zIndex>
		</text>


		<!-- --- Boxes help graphic --- -->

		<image name="grid_help" extra="true">
			<path>./_inc/assets/tilehelp.svg</path>
			<origin>1 1</origin>
			<pos>0.9463541666666667 0.9601851851851852</pos>
			<maxSize>0.546875 0.05</maxSize>
			<zIndex>100</zIndex>
		</image>


		<image name="primaryBtn" extra="true">
			<linearSmooth>true</linearSmooth>
			<pos>0.052083333333333 0.7972222222222222</pos>
			<size>0.036458333333333 0.122222222222222</size>
			<zIndex>100</zIndex>
		</image>

		<image name="selectTxt" extra="true">
			<pos>0.051375 0.925</pos>
			<size>0.036458333333333 0.02037037037037</size>
			<path>./_inc/assets/selectTxt.png</path>
			<zIndex>100</zIndex>
		</image>

		<image name="secondaryBtn" extra="true">
			<linearSmooth>true</linearSmooth>
			<pos>0.091666666666667 0.7972222222222222</pos>
			<size>0.036458333333333 0.122222222222222</size>
			<zIndex>100</zIndex>
		</image>

		<image name="backTxt" extra="true">
			<pos>0.0909583333333333 0.925</pos>
			<size>0.036458333333333 0.02037037037037</size>
			<path>./_inc/assets/backTxt.png</path>
			<zIndex>100</zIndex>
		</image>

	</customView>

</theme>

